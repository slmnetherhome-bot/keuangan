# Salin file ini menjadi .env.local lalu isi nilai-nilainya
# (jangan commit .env.local — sudah di-ignore oleh git)

# ID Google Spreadsheet (bagian dari URL sheet, setelah /d/ ... /edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# OPSI 1: Kredensial service account sebagai base64 dari file JSON
# (hasilkan dengan: node -e "process.stdout.write(Buffer.from(require('fs').readFileSync('credentials/service-account.json')).toString('base64'))")
GOOGLE_SERVICE_ACCOUNT_BASE64=

# OPSI 2 (alternatif): letakkan file JSON service account di folder credentials/service-account.json
# dan biarkan GOOGLE_SERVICE_ACCOUNT_BASE64 kosong

# VAPID keys untuk Web Push (generate: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@keuangan.local
